"""
app.py: the competition API (FastAPI). Run:  uvicorn app:app --host 0.0.0.0 --port 8000

Environment:
  COMP_DB, COMP_UPLOADS     database file / folder for submitted code
  PROXY_SECRET              if set, every request (except /health) must carry X-Proxy-Secret: <this>
  ADMIN_TOKEN               enables /admin/* (send X-Admin-Token)
  AUTH_MODE                 "proxy" (default): the Vercel proxy sends the Microsoft identity in X-User-Id / X-User-Email
                            "password": team name + password login with cookie sessions (local development, tests)
  SIGNUP_MODE               "open" (default): anyone who signs in can create a team or join one with a code
                            "invite": only accounts the organisers registered (manage.py import-members)
  ALLOWED_TENANT_ID         if set, only Microsoft accounts from this tenant (X-User-Tenant) may use the API
  COMP_MAX_TEAMS, COMP_MAX_TEAM_SIZE   sign-up caps (defaults 60 and 5)
  COOKIE_SECURE             "1" (default) or "0" for plain-http local development (password mode only)
  EVENT_START, EVENT_LOCK   ISO-8601 UTC, defaults match the real event
  COMP_COOLDOWN_S, COMP_DAILY_LIMIT, COMP_MAX_BYTES   rule overrides (defaults 300, 15, 102400)
"""
import ast
import re
import hashlib
import hmac
import json
import os
import secrets
import sqlite3
import time
import uuid
from contextlib import contextmanager

from fastapi import Depends, FastAPI, File, Request, Response, UploadFile
from fastapi.exceptions import RequestValidationError
from fastapi.responses import JSONResponse
from pydantic import BaseModel

import common
import worker

SESSION_SECONDS = 7 * 24 * 3600
RESULT_FIELDS = ("pnl", "aborted", "message", "pnl_by_product", "max_drawdown", "limit_violations",
                 "timeouts", "crashes", "errors", "restarts", "invalid", "mean_tick_ms", "p99_tick_ms",
                 "max_tick_ms", "ticks", "elapsed_s", "pnl_curve", "logs")

app = FastAPI(title="Quant Club Trading Competition API")


def env_int(name, default):
    return int(os.environ.get(name, default))


def db_path():
    return os.environ.get("COMP_DB", "jobs.db")


_initialised = set()


@contextmanager
def db():
    path = db_path()
    if path not in _initialised:          # create tables on first use of this database file
        common.init_db(path).close()
        _initialised.add(path)
    conn = sqlite3.connect(path, timeout=30, isolation_level=None)
    conn.row_factory = sqlite3.Row
    try:
        yield conn
    finally:
        conn.close()


# ---- errors ------------------------------------------------------------------
class ApiError(Exception):
    def __init__(self, status, code, message, **extra):
        self.status, self.code, self.message, self.extra = status, code, message, extra


@app.exception_handler(ApiError)
async def _api_error(request, e):
    return JSONResponse(status_code=e.status, content={"error": e.code, "message": e.message, **e.extra})


@app.exception_handler(RequestValidationError)
async def _validation_error(request, e):
    return JSONResponse(status_code=400, content={"error": "bad_request", "message": "Invalid request."})


# ---- guards ---------------------------------------------------------------------
@app.middleware("http")
async def guard(request: Request, call_next):
    secret = os.environ.get("PROXY_SECRET", "")
    if secret and request.url.path != "/health":
        if not hmac.compare_digest(request.headers.get("x-proxy-secret", ""), secret):
            return JSONResponse(status_code=403, content={"error": "forbidden", "message": "Forbidden."})
    cl = request.headers.get("content-length", "")
    if cl.isdigit() and int(cl) > 4 * env_int("COMP_MAX_BYTES", 102400):
        return JSONResponse(status_code=413, content={"error": "too_large", "message": "Request body too large."})
    return await call_next(request)


def auth_mode():
    return os.environ.get("AUTH_MODE", "proxy")


NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 _-]{1,29}$")


def signup_mode():
    return os.environ.get("SIGNUP_MODE", "open")


def identity(request: Request):
    """The signed-in Microsoft user, as told to us by the proxy. We trust these headers only because the request carried
    the proxy secret (checked in the middleware)."""
    if not os.environ.get("PROXY_SECRET"):
        raise ApiError(500, "misconfigured", "Server misconfigured: PROXY_SECRET must be set in proxy auth mode.")
    uid = request.headers.get("x-user-id", "").strip()
    email = request.headers.get("x-user-email", "").strip().lower()
    name = request.headers.get("x-user-name", "").strip()[:60]
    tenant = request.headers.get("x-user-tenant", "").strip().lower()
    if not uid:
        raise ApiError(401, "not_logged_in", "Please sign in.")
    allowed = os.environ.get("ALLOWED_TENANT_ID", "").strip().lower()
    if allowed and tenant != allowed:
        raise ApiError(403, "wrong_tenant", "Please sign in with your university Microsoft account.")
    return uid, email, name


def find_team(c, uid, email):
    """The user's team, or None. The stable user id decides. If the organisers pre-registered this email and it is not
    linked yet, link it now (email is used ONLY for this first link; Microsoft advises against email as an identity)."""
    row = c.execute("SELECT team FROM members WHERE user_id=?", (uid,)).fetchone()
    if row:
        return row["team"]
    if email:
        c.execute("BEGIN IMMEDIATE")
        try:
            m = c.execute("SELECT team, user_id FROM members WHERE email=?", (email,)).fetchone()
            if m and m["user_id"] is None:
                c.execute("UPDATE members SET user_id=? WHERE email=?", (uid, email))
                c.execute("COMMIT")
                return m["team"]
            c.execute("ROLLBACK")
        except BaseException:
            c.execute("ROLLBACK")
            raise
        if m:
            raise ApiError(403, "account_mismatch", "This email is already linked to a different Microsoft account. Contact the organisers.")
    return None


def team_from_proxy(request: Request):
    uid, email, _ = identity(request)
    with db() as c:
        team = find_team(c, uid, email)
    if team:
        return team
    if signup_mode() == "open":
        raise ApiError(403, "no_team", "Create a team or join one with a code first.")
    raise ApiError(403, "not_registered", f"The account {email or uid} is not registered to a team. Contact the organisers and tell them this address.")


def current_team(request: Request):
    if auth_mode() == "proxy":
        return team_from_proxy(request)
    tok = request.cookies.get("session")
    if not tok:
        raise ApiError(401, "not_logged_in", "Please log in.")
    with db() as c:
        row = c.execute("SELECT team, expires FROM sessions WHERE token_hash=?",
                        (hashlib.sha256(tok.encode()).hexdigest(),)).fetchone()
    if not row or row["expires"] < time.time():
        raise ApiError(401, "not_logged_in", "Session expired. Please log in again.")
    return row["team"]


def require_admin(request: Request):
    token = os.environ.get("ADMIN_TOKEN", "")
    if not token or not hmac.compare_digest(request.headers.get("x-admin-token", ""), token):
        raise ApiError(403, "forbidden", "Forbidden.")


# ---- public ----------------------------------------------------------------------
@app.get("/health")
def health():
    return {"ok": True}


@app.get("/event")
def event():
    start, lock = common.event_times()
    with db() as c:
        released = common.get_setting(c, "results_released", "0") == "1"
    return {"state": common.event_state(), "start": common.iso(start), "lock": common.iso(lock),
            "now": common.iso(time.time()), "results_released": released,
            "limits": {"max_bytes": env_int("COMP_MAX_BYTES", 102400),
                       "cooldown_seconds": env_int("COMP_COOLDOWN_S", 300),
                       "daily_limit": env_int("COMP_DAILY_LIMIT", 15)}}


# ---- auth ------------------------------------------------------------------------
class LoginBody(BaseModel):
    team: str
    password: str


def _password_mode_only():
    if auth_mode() != "password":
        raise ApiError(404, "not_found", "Not available: sign in with your Microsoft account.")


@app.post("/auth/login")
def login(body: LoginBody, response: Response):
    _password_mode_only()
    name, now = body.team.strip().lower(), time.time()
    with db() as c:
        fails = c.execute("SELECT COUNT(*) FROM login_failures WHERE team=? AND ts>?", (name, now - 600)).fetchone()[0]
        if fails >= 10:
            raise ApiError(429, "too_many_attempts", "Too many failed logins. Try again in 10 minutes.")
        row = c.execute("SELECT * FROM teams WHERE name=?", (body.team.strip(),)).fetchone()
        has_pw = bool(row and row["password_hash"])
        good = common.verify_password(body.password, row["password_hash"] if has_pw else common.DUMMY_HASH)
        if not (has_pw and good):          # a team without a password can never log in this way
            c.execute("INSERT INTO login_failures(team, ts) VALUES (?,?)", (name, now))
            raise ApiError(401, "invalid_credentials", "Wrong team name or password.")
        c.execute("DELETE FROM login_failures WHERE team=?", (name,))
        token = secrets.token_urlsafe(32)
        c.execute("INSERT INTO sessions(token_hash, team, created, expires) VALUES (?,?,?,?)",
                  (hashlib.sha256(token.encode()).hexdigest(), row["name"], now, now + SESSION_SECONDS))
    response.set_cookie("session", token, max_age=SESSION_SECONDS, httponly=True, samesite="lax",
                        secure=os.environ.get("COOKIE_SECURE", "1") == "1", path="/")
    return {"team": row["name"]}


@app.post("/auth/logout")
def logout(request: Request, response: Response):
    _password_mode_only()
    tok = request.cookies.get("session")
    if tok:
        with db() as c:
            c.execute("DELETE FROM sessions WHERE token_hash=?", (hashlib.sha256(tok.encode()).hexdigest(),))
    response.delete_cookie("session", path="/")
    return {"ok": True}


@app.get("/me")
def me(request: Request):
    if auth_mode() != "proxy":
        return {"team": current_team(request)}
    uid, email, _ = identity(request)
    with db() as c:
        team = find_team(c, uid, email)
    if team is None and signup_mode() != "open":
        raise ApiError(403, "not_registered", f"The account {email or uid} is not registered to a team. Contact the organisers and tell them this address.")
    return {"team": team, "email": email or None, "signup": signup_mode()}   # team is null until they create or join one



# ---- teams (open sign-up) --------------------------------------------------------------------
class TeamBody(BaseModel):
    name: str


class JoinBody(BaseModel):
    code: str


def _open_signup_only():
    if auth_mode() != "proxy":
        raise ApiError(404, "not_found", "Not available.")
    if signup_mode() != "open":
        raise ApiError(403, "signup_closed", "Team sign-up is closed: ask the organisers to register your account.")
    if common.event_state() == "locked":
        raise ApiError(403, "event_locked", "Sign-up is closed: the event has ended.")


def _add_member(c, uid, email, name, team):
    if email and c.execute("SELECT 1 FROM members WHERE email=?", (email,)).fetchone():
        email = None                      # that address belongs to another row; the user id is what matters
    display = name or (email.split("@")[0] if email else "member")
    c.execute("INSERT INTO members(email, team, user_id, display_name) VALUES (?,?,?,?)", (email or None, team, uid, display))


@app.post("/teams", status_code=201)
def create_team(body: TeamBody, request: Request):
    _open_signup_only()
    uid, email, name = identity(request)
    team_name = " ".join(body.name.split())
    if not NAME_RE.match(team_name):
        raise ApiError(400, "invalid_name", "Team names are 2 to 30 characters: letters, digits, spaces, - and _.")
    with db() as c:
        if find_team(c, uid, email):
            raise ApiError(409, "already_in_team", "You are already on a team.")
        c.execute("BEGIN IMMEDIATE")
        try:
            if c.execute("SELECT COUNT(*) FROM teams").fetchone()[0] >= env_int("COMP_MAX_TEAMS", 60):
                raise ApiError(403, "teams_full", "The event has reached its maximum number of teams.")
            if c.execute("SELECT 1 FROM teams WHERE name=?", (team_name,)).fetchone():
                raise ApiError(409, "name_taken", "That team name is already taken.")
            code = common.new_join_code(c)
            c.execute("INSERT INTO teams(name, password_hash, created, join_code, source) VALUES (?,NULL,?,?,'self')",
                      (team_name, time.time(), code))
            _add_member(c, uid, email, name, team_name)
            c.execute("COMMIT")
        except sqlite3.IntegrityError:
            c.execute("ROLLBACK")
            raise ApiError(409, "already_in_team", "You are already on a team.")
        except BaseException:
            c.execute("ROLLBACK")
            raise
    return {"team": team_name, "join_code": code}


@app.post("/teams/join")
def join_team(body: JoinBody, request: Request):
    _open_signup_only()
    uid, email, name = identity(request)
    key, now = "join:" + uid, time.time()
    with db() as c:
        if find_team(c, uid, email):
            raise ApiError(409, "already_in_team", "You are already on a team.")
        if c.execute("SELECT COUNT(*) FROM login_failures WHERE team=? AND ts>?", (key, now - 600)).fetchone()[0] >= 10:
            raise ApiError(429, "too_many_attempts", "Too many wrong codes. Try again in 10 minutes.")
        t = c.execute("SELECT name FROM teams WHERE join_code=?", (body.code.strip().upper(),)).fetchone()
        if not t:
            c.execute("INSERT INTO login_failures(team, ts) VALUES (?,?)", (key, now))
            raise ApiError(404, "invalid_code", "That join code does not match any team.")
        c.execute("BEGIN IMMEDIATE")
        try:
            if c.execute("SELECT COUNT(*) FROM members WHERE team=?", (t["name"],)).fetchone()[0] >= env_int("COMP_MAX_TEAM_SIZE", 5):
                raise ApiError(409, "team_full", f"That team already has {env_int('COMP_MAX_TEAM_SIZE', 5)} members.")
            _add_member(c, uid, email, name, t["name"])
            c.execute("COMMIT")
        except sqlite3.IntegrityError:
            c.execute("ROLLBACK")
            raise ApiError(409, "already_in_team", "You are already on a team.")
        except BaseException:
            c.execute("ROLLBACK")
            raise
    return {"team": t["name"]}


@app.get("/teams/mine")
def my_team(team: str = Depends(current_team)):
    with db() as c:
        t = c.execute("SELECT name, join_code FROM teams WHERE name=?", (team,)).fetchone()
        code = t["join_code"]
        if not code and signup_mode() == "open":      # teams the organisers created get a code the first time it is needed
            code = common.new_join_code(c)
            c.execute("UPDATE teams SET join_code=? WHERE name=?", (code, team))
        mem = c.execute("SELECT display_name FROM members WHERE team=? ORDER BY id", (team,)).fetchall()
    return {"name": t["name"], "join_code": code, "max_size": env_int("COMP_MAX_TEAM_SIZE", 5),
            "members": [{"name": m["display_name"] or "member"} for m in mem]}


# ---- submissions -------------------------------------------------------------------
def summarize(row, c=None):
    d = {"id": row["id"], "created": common.iso(row["created"]), "status": row["status"]}
    if row["result_json"]:
        res = json.loads(row["result_json"])
        d["pnl"] = res.get("pnl")
        d["aborted"] = bool(res.get("aborted"))
        d["message"] = (res.get("message") or "")[:200]
    if row["status"] == "queued" and c is not None:
        d["queue_position"] = c.execute("SELECT COUNT(*) FROM jobs WHERE status='queued' AND id<?", (row["id"],)).fetchone()[0] + 1
    return d


@app.post("/submissions", status_code=202)
async def submit(file: UploadFile = File(...), team: str = Depends(current_team)):
    state = common.event_state()
    if state == "before":
        raise ApiError(403, "event_not_open", "Submissions are not open yet.")
    if state == "locked":
        raise ApiError(403, "event_locked", "Submissions are locked.")
    max_bytes = env_int("COMP_MAX_BYTES", 102400)
    if not (file.filename or "").lower().endswith(".py"):
        raise ApiError(400, "invalid_file", "Upload a single .py file.")
    data = await file.read(max_bytes + 1)
    if len(data) > max_bytes:
        raise ApiError(413, "too_large", f"File is larger than {max_bytes // 1024} KB.")
    try:
        source = data.decode("utf-8")
        ast.parse(source)
    except UnicodeDecodeError:
        raise ApiError(400, "invalid_file", "File must be UTF-8 text.")
    except SyntaxError as e:
        raise ApiError(400, "syntax_error", f"Syntax error on line {e.lineno}: {e.msg}")

    updir = os.path.join(os.environ.get("COMP_UPLOADS", "uploads"), "".join(ch for ch in team if ch.isalnum() or ch in "-_") or "team")
    os.makedirs(updir, exist_ok=True)
    path = os.path.join(updir, uuid.uuid4().hex + ".py")
    with open(path, "wb") as f:
        f.write(data)

    now, cooldown, daily = time.time(), env_int("COMP_COOLDOWN_S", 300), env_int("COMP_DAILY_LIMIT", 15)
    with db() as c:
        c.execute("BEGIN IMMEDIATE")
        try:
            if c.execute("SELECT COUNT(*) FROM jobs WHERE team=? AND kind='slice' AND status IN ('queued','running')", (team,)).fetchone()[0]:
                raise ApiError(409, "active_job", "You already have a submission running. Wait for it to finish.")
            last = c.execute("SELECT MAX(created) FROM jobs WHERE team=? AND kind='slice'", (team,)).fetchone()[0]
            if last and now - last < cooldown:
                wait = int(cooldown - (now - last)) + 1
                raise ApiError(429, "cooldown", f"Please wait {wait} s before submitting again.", retry_after_seconds=wait)
            if c.execute("SELECT COUNT(*) FROM jobs WHERE team=? AND kind='slice' AND created>?", (team, now - 86400)).fetchone()[0] >= daily:
                raise ApiError(429, "daily_limit", f"Daily limit of {daily} submissions reached.")
            job_id = worker.enqueue(c, team, "slice", path)
            c.execute("COMMIT")
        except BaseException:
            c.execute("ROLLBACK")
            os.remove(path)
            raise
    return {"id": job_id, "status": "queued", "created": common.iso(now)}


@app.get("/submissions")
def list_submissions(team: str = Depends(current_team)):
    with db() as c:
        rows = c.execute("SELECT * FROM jobs WHERE team=? AND kind='slice' ORDER BY id DESC LIMIT 100", (team,)).fetchall()
        return {"submissions": [summarize(r, c) for r in rows]}


@app.get("/submissions/{sid}")
def get_submission(sid: int, team: str = Depends(current_team)):
    with db() as c:
        row = c.execute("SELECT * FROM jobs WHERE id=? AND team=? AND kind='slice'", (sid, team)).fetchone()
        if not row:
            raise ApiError(404, "not_found", "Submission not found.")
        d = summarize(row, c)
    if row["result_json"]:
        res = json.loads(row["result_json"])
        d["result"] = {k: res[k] for k in RESULT_FIELDS if k in res}
    return d


@app.get("/leaderboard")
def leaderboard():
    with db() as c:
        if common.get_setting(c, "results_released", "0") != "1":
            raise ApiError(403, "results_not_released", "Results have not been released yet.")
        ranked, _ = common.build_leaderboard(c)
    return {"leaderboard": [{"rank": r, "team": t, "pnl": res["pnl"], "max_drawdown": res.get("max_drawdown"),
                             "aborted": bool(res.get("aborted")), "no_submission": bool(res.get("no_submission"))} for r, t, res in ranked]}


# ---- admin (X-Admin-Token) ----------------------------------------------------------
@app.get("/admin/queue", dependencies=[Depends(require_admin)])
def admin_queue():
    with db() as c:
        counts = {r["status"]: r["n"] for r in c.execute("SELECT status, COUNT(*) n FROM jobs GROUP BY status")}
        jobs = [{"id": r["id"], "team": r["team"], "kind": r["kind"], "status": r["status"], "attempts": r["attempts"],
                 "created": common.iso(r["created"])} for r in c.execute("SELECT * FROM jobs ORDER BY id DESC LIMIT 50")]
    return {"counts": counts, "recent": jobs}


@app.get("/admin/teams", dependencies=[Depends(require_admin)])
def admin_teams():
    with db() as c:
        rows = c.execute("SELECT t.name, COUNT(j.id) n, MAX(j.created) last FROM teams t "
                         "LEFT JOIN jobs j ON j.team=t.name AND j.kind='slice' GROUP BY t.name ORDER BY t.name").fetchall()
    return {"teams": [{"name": r["name"], "submissions": r["n"], "last_submission": common.iso(r["last"]) if r["last"] else None} for r in rows]}


@app.post("/admin/rerun/{jid}", dependencies=[Depends(require_admin)])
def admin_rerun(jid: int):
    with db() as c:
        row = c.execute("SELECT status FROM jobs WHERE id=?", (jid,)).fetchone()
        if not row:
            raise ApiError(404, "not_found", "No such job.")
        if row["status"] not in ("done", "error"):
            raise ApiError(409, "not_finished", "Job is still queued or running.")
        c.execute("UPDATE jobs SET status='queued', attempts=0, started=NULL, finished=NULL, result_json=NULL WHERE id=?", (jid,))
    return {"ok": True}


class ReleaseBody(BaseModel):
    released: bool
    force: bool = False


@app.post("/admin/release", dependencies=[Depends(require_admin)])
def admin_release(body: ReleaseBody):
    with db() as c:
        if body.released and not body.force:
            ranked, problems = common.build_leaderboard(c)
            if problems or not ranked:
                raise ApiError(409, "not_ready", "Final results are incomplete.", problems=[list(p) for p in problems])
        common.set_setting(c, "results_released", "1" if body.released else "0")
    return {"results_released": body.released}
